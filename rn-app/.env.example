# Supabase Configuration (Required for API proxy)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_ANDROID_UPDATE_MANIFEST_URL=https://nativeos.oss-cn-beijing.aliyuncs.com/app/android/version.json

# ⚠️ SECURITY: API keys should NEVER be in client code
# Configure these in Supabase Dashboard → Edge Functions → Secrets:
# - OPENAI_API_KEY (for AI proxy)
# - ELEVENLABS_API_KEY (for TTS proxy)

# Legacy (deprecated - use Supabase proxy instead)
# EXPO_PUBLIC_AI_API_KEY=DO_NOT_USE
# EXPO_PUBLIC_TTS_API_KEY=DO_NOT_USE

# Local Volc proxy (development)
# Android 模拟器可用 10.0.2.2；真机请改成宿主机局域网 IP，例如 http://192.168.1.10:8788/asr-upload
EXPO_PUBLIC_VOLC_PROXY_TTS_URL=http://localhost:8788/tts
EXPO_PUBLIC_VOLC_PROXY_ASR_URL=ws://localhost:8788/asr
EXPO_PUBLIC_VOLC_PROXY_ASR_UPLOAD_URL=http://10.0.2.2:8788/asr-upload
EXPO_PUBLIC_VOLC_PROXY_ASR_REMOTE_URL=http://10.0.2.2:8788/asr-remote
