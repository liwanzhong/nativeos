# ============================================================
# NativeOS Admin — local config (OPTIONAL)
# ============================================================
# Normally you don't need this file — the app falls back to
# `../rn-app/.env.local` for the Supabase URL and service_role key.
#
# Create this file ONLY when you want to override the rn-app values
# (e.g. point at a staging Supabase project).
#
# `.env` is gitignored — do NOT commit real keys.
#
# Recognized key names (case-insensitive):
#   - SUPABASE_URL  (or EXPO_PUBLIC_SUPABASE_URL)
#   - SUPABASE_SERVICE_KEY  (or SUPABASE_SERVICE_ROLE_KEY)

# --- Supabase (only needed if overriding rn-app's .env.local) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...replace-me
